# Production build-time env for admin-web (committed on purpose).
#
# The Google Web OAuth Client ID is PUBLIC by design (it's sent to every
# browser), so it's safe in the repo — same value already lives in render.yaml.
# Committing it here guarantees `vite build` bakes it in on every deploy, so the
# "Sign in with Google" button never silently disappears due to a missing
# dashboard env var. Admin Google sign-in authenticates EXISTING admins only.
#
# NOTE: VITE_GATEWAY_URL is intentionally NOT set here — it comes from the
# Render service env so prod points at the real gateway. Vite won't override an
# env var that's already provided by the environment.
VITE_GOOGLE_CLIENT_ID=965066144511-qf8kg4hdrpuk86qd7tgf59a9l21hmpgt.apps.googleusercontent.com
