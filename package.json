{
  "name": "magizhnaazh-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:customer": "npm run dev --prefix apps/customer-web",
    "dev:vendor": "npm run dev --prefix apps/vendor-web",
    "dev:admin": "npm run dev --prefix apps/admin-web",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "dev:gateway": "npx tsx watch services/gateway/index.ts",
    "dev:auth": "npx tsx watch services/auth-service/index.ts",
    "dev:marketplace": "npx tsx watch services/marketplace-service/index.ts",
    "dev:event-budget": "npx tsx watch services/event-budget-service/index.ts",
    "dev:booking": "npx tsx watch services/booking-payment-service/index.ts",
    "dev:invitation": "npx tsx watch services/invitation-service/index.ts",
    "dev:guest-feedback": "npx tsx watch services/guest-feedback-service/index.ts",
    "dev:monitor": "npx tsx watch services/monitor-service/index.ts",
    "build:all": "npm run build --prefix apps/customer-web && npm run build --prefix apps/vendor-web && npm run build --prefix apps/admin-web",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3"
  }
}
