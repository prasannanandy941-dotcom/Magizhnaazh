PORT=8002
MONGODB_URI=mongodb://localhost:27017/magizhnaazh_marketplace
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL where uploaded files are served to browsers. In production
# nginx exposes /uploads on the API domain, so set this to that public URL
# (e.g. https://event-api.porulontech.com). If unset, uploaded image URLs fall
# back to localhost and show as broken images. Leave unset for local dev.
# PUBLIC_UPLOADS_BASE_URL=https://event-api.porulontech.com
