PORT=8001
MONGODB_URI=mongodb://localhost:27017/magizhnaazh_auth

# Must match the JWT_SECRET used by every other service — each service
# verifies tokens independently rather than calling back into auth-service.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# --- Google Sign-In ---
# The OAuth 2.0 "Web application" Client ID from Google Cloud Console
# (https://console.cloud.google.com/apis/credentials). Must be the SAME value
# the frontends use as VITE_GOOGLE_CLIENT_ID. If unset, "Sign in with Google"
# is disabled and the button is hidden — the app keeps working with email/password.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Email (OTP) via Brevo HTTPS API (recommended for Render) ---
# Render's free tier BLOCKS outbound SMTP ports, so nodemailer hangs/times out.
# Brevo's HTTP API uses ordinary HTTPS (port 443) and works there. When set, it
# is used first and SMTP below is only a fallback.
#   1. Get the key at https://app.brevo.com/settings/keys/api (starts "xkeysib-").
#      NOTE: this is the API v3 key, NOT the SMTP key ("xsmtpsib-").
#   2. Verify your "from" address (SMTP_FROM) as a sender in Brevo → Senders,
#      and ideally authenticate its domain (SPF/DKIM) for inbox delivery.
BREVO_API_KEY=xkeysib-your-api-v3-key

# --- Email (OTP) via SMTP (fallback / local dev) ---
# Emails the 6-digit signup verification code. Without SMTP_USER + SMTP_PASS,
# the OTP is only printed to the auth-service console.
# Recommended: Brevo (brevo.com) — free, no 2FA hoops.
#   SMTP_USER = the "Login" from https://app.brevo.com/settings/keys/smtp
#               (looks like xxxxxx@smtp-brevo.com — NOT your account email)
#   SMTP_PASS = a generated "SMTP key" from that same page
#   SMTP_FROM = a *verified sender* address (your Brevo signup email is
#               auto-verified). This is the visible "from" and differs from
#               SMTP_USER, which is only the relay login.
# (Gmail also works via an App Password, but requires 2-Step Verification.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxxxxx@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=your-verified-sender@example.com
