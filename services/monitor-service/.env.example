# --- Monitor service ---
PORT=8007

# Shared JWT secret (must match the other services) — required so the admin
# "Restart" endpoint can verify the caller is an authenticated admin.
JWT_SECRET=change-me-to-match-other-services

# How often (ms) to poll every service's /health endpoint.
MONITOR_POLL_INTERVAL_MS=10000

# --- Alerting (all optional; each channel is skipped if left blank) ---

# Slack Incoming Webhook. Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# SMTP email alerts (via nodemailer). Leave SMTP_HOST blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Auto-restart ---
# When "true", the monitor may spawn a fresh dev process for a DOWN service
# (npm run dev:<key> at the repo root). Local-dev only. Leave false in any
# shared/production environment.
MONITOR_ALLOW_RESTART=false
# Seconds to wait before the monitor will attempt another auto-restart of the
# same service, to avoid thrashing.
MONITOR_RESTART_COOLDOWN_S=60
